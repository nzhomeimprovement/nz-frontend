# Email Configuration - Resend (HTTPS API). Copy to .env.local and fill in real values.
# .env.local is gitignored and must never be committed. Set the same vars in Vercel's
# Environment Variables settings for production.
RESEND_API_KEY=re_your_api_key_here
FROM_NAME=Your Company Name
FROM_EMAIL=leads@example.com
CONTACT_EMAIL=leads@example.com
